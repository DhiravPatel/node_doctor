{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://node.doctor/schema/node-doctor.config.schema.json",
  "title": "node-doctor config",
  "description": "Configuration for node.doctor (node-doctor.config.json / package.json#nodeDoctor).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "diagnostics": {
      "type": "object",
      "description": "Per-diagnostic severity override.",
      "propertyNames": {
        "enum": [
          "ai-call-in-loop",
          "ci-pull-request-target-checkout",
          "ci-script-injection",
          "ci-unpinned-action",
          "cors-credentials-reflect",
          "deep-nesting",
          "dockerfile-mutable-base-tag",
          "dockerfile-runs-as-root",
          "dockerfile-secret-in-build-stage",
          "express-async-handler-unprotected",
          "express-missing-return-after-response",
          "fastify-missing-schema",
          "graphql-introspection-in-production",
          "graphql-missing-depth-limit",
          "graphql-resolver-returns-raw-error",
          "grpc-insecure-credentials",
          "hapi-route-auth-disabled",
          "hapi-route-missing-validation",
          "high-cyclomatic-complexity",
          "jwt-missing-expiration",
          "k8s-host-namespace",
          "k8s-missing-resource-limits",
          "k8s-privileged-container",
          "max-function-length",
          "mcp-tool-unrestricted-capability",
          "migration-add-not-null-without-default",
          "migration-destructive-without-guard",
          "migration-missing-index-on-foreign-key",
          "nest-missing-validation-pipe",
          "no-async-array-callback",
          "no-async-executor",
          "no-await-in-loop-over-independent-work",
          "no-cache-without-ttl",
          "no-circular-imports",
          "no-committed-env-secret",
          "no-committed-private-key",
          "no-console-log-in-committed-code",
          "no-constant-condition",
          "no-cross-request-state-mutation",
          "no-db-connection-per-request",
          "no-dead-async",
          "no-deprecated-node-api",
          "no-disabled-tls-verification",
          "no-duplicate-route-definition",
          "no-error-leak-to-client",
          "no-eval-with-input",
          "no-exec-with-interpolation",
          "no-external-call-inside-open-transaction",
          "no-findmany-then-filter-in-js",
          "no-floating-promise",
          "no-function-constructor-with-input",
          "no-hardcoded-secret-literal",
          "no-infinite-retry-without-backoff",
          "no-jwt-decode-as-verify",
          "no-jwt-none-algorithm",
          "no-large-json-parse-in-request-path",
          "no-listener-added-per-request",
          "no-llm-output-in-sink",
          "no-math-random-for-token",
          "no-missing-await-on-query",
          "no-missing-body-size-limit",
          "no-missing-catch-on-async-iife",
          "no-missing-stream-error-handler",
          "no-node-builtin-on-edge",
          "no-nosql-object-injection",
          "no-open-redirect",
          "no-open-security-group",
          "no-overbroad-iam-policy",
          "no-path-traversal",
          "no-process-exit-in-request-path",
          "no-prompt-injection",
          "no-prototype-pollution",
          "no-public-cloud-storage",
          "no-query-in-loop",
          "no-race-without-timeout",
          "no-redos-prone-regex",
          "no-redundant-try-catch-rethrow",
          "no-secret-in-config-file",
          "no-send-after-next",
          "no-sensitive-data-in-logs",
          "no-sql-template-interpolation",
          "no-ssrf-unvalidated-url",
          "no-state-change-on-get",
          "no-swallowed-error-empty-catch",
          "no-sync-bcrypt-in-request-path",
          "no-sync-io-in-request-path",
          "no-sync-io-reachable-from-handler",
          "no-system-prompt-leak",
          "no-tainted-sink-via-helper",
          "no-throw-in-finally",
          "no-timing-unsafe-secret-compare",
          "no-trust-proxy-true",
          "no-unbounded-module-cache",
          "no-unbounded-promise-all",
          "no-unchecked-required-env",
          "no-uncleared-module-interval",
          "no-unreachable-code",
          "no-unsafe-deserialization",
          "no-unsafe-regexp-from-input",
          "no-vm-run-untrusted",
          "no-weak-cipher",
          "no-weak-hash-for-password",
          "no-xss-in-html-response",
          "prefer-node-protocol-imports",
          "require-error-handling-middleware",
          "require-fetch-timeout",
          "require-jwt-algorithms-allowlist",
          "require-pagination-limit",
          "require-secure-cookie-flags",
          "require-sigterm-handler",
          "restify-missing-error-handler",
          "secret-in-env-fallback"
        ]
      },
      "additionalProperties": {
        "enum": [
          "off",
          "warn",
          "error"
        ]
      }
    },
    "ignoreTags": {
      "type": "array",
      "description": "Diagnostic families to disable.",
      "items": {
        "enum": [
          "access-control",
          "ai",
          "architecture",
          "async",
          "auth",
          "cache",
          "ci",
          "complexity",
          "concurrency",
          "config",
          "container",
          "control-flow",
          "cors",
          "cost",
          "crypto",
          "csrf",
          "data-loss",
          "database",
          "db",
          "deploy",
          "deprecation",
          "deserialization",
          "docker",
          "dos",
          "edge",
          "env",
          "error-handling",
          "event-loop",
          "express",
          "fastify",
          "fs",
          "graphql",
          "grpc",
          "hapi",
          "http",
          "hygiene",
          "iac",
          "iam",
          "imports",
          "index",
          "info-leak",
          "injection",
          "input",
          "jwt",
          "k8s",
          "leak",
          "lifecycle",
          "logging",
          "mcp",
          "memory",
          "migration",
          "modernization",
          "n+1",
          "nest",
          "network",
          "performance",
          "prompt",
          "prototype-pollution",
          "rce",
          "reliability",
          "reproducibility",
          "restify",
          "secrets",
          "security",
          "state",
          "storage",
          "supply-chain",
          "taint",
          "transport",
          "typed",
          "validation"
        ]
      },
      "uniqueItems": true
    },
    "ignore": {
      "type": "array",
      "description": "Extra path globs to skip.",
      "items": {
        "type": "string"
      }
    },
    "blocking": {
      "description": "Default exit policy.",
      "enum": [
        "error",
        "warning",
        "none"
      ]
    },
    "rootDir": {
      "type": "string",
      "description": "Redirect the scan to another directory (resolved against this file)."
    },
    "overrides": {
      "type": "array",
      "description": "Per-path severity overrides.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "files",
          "diagnostics"
        ],
        "properties": {
          "files": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "diagnostics": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "ai-call-in-loop",
                "ci-pull-request-target-checkout",
                "ci-script-injection",
                "ci-unpinned-action",
                "cors-credentials-reflect",
                "deep-nesting",
                "dockerfile-mutable-base-tag",
                "dockerfile-runs-as-root",
                "dockerfile-secret-in-build-stage",
                "express-async-handler-unprotected",
                "express-missing-return-after-response",
                "fastify-missing-schema",
                "graphql-introspection-in-production",
                "graphql-missing-depth-limit",
                "graphql-resolver-returns-raw-error",
                "grpc-insecure-credentials",
                "hapi-route-auth-disabled",
                "hapi-route-missing-validation",
                "high-cyclomatic-complexity",
                "jwt-missing-expiration",
                "k8s-host-namespace",
                "k8s-missing-resource-limits",
                "k8s-privileged-container",
                "max-function-length",
                "mcp-tool-unrestricted-capability",
                "migration-add-not-null-without-default",
                "migration-destructive-without-guard",
                "migration-missing-index-on-foreign-key",
                "nest-missing-validation-pipe",
                "no-async-array-callback",
                "no-async-executor",
                "no-await-in-loop-over-independent-work",
                "no-cache-without-ttl",
                "no-circular-imports",
                "no-committed-env-secret",
                "no-committed-private-key",
                "no-console-log-in-committed-code",
                "no-constant-condition",
                "no-cross-request-state-mutation",
                "no-db-connection-per-request",
                "no-dead-async",
                "no-deprecated-node-api",
                "no-disabled-tls-verification",
                "no-duplicate-route-definition",
                "no-error-leak-to-client",
                "no-eval-with-input",
                "no-exec-with-interpolation",
                "no-external-call-inside-open-transaction",
                "no-findmany-then-filter-in-js",
                "no-floating-promise",
                "no-function-constructor-with-input",
                "no-hardcoded-secret-literal",
                "no-infinite-retry-without-backoff",
                "no-jwt-decode-as-verify",
                "no-jwt-none-algorithm",
                "no-large-json-parse-in-request-path",
                "no-listener-added-per-request",
                "no-llm-output-in-sink",
                "no-math-random-for-token",
                "no-missing-await-on-query",
                "no-missing-body-size-limit",
                "no-missing-catch-on-async-iife",
                "no-missing-stream-error-handler",
                "no-node-builtin-on-edge",
                "no-nosql-object-injection",
                "no-open-redirect",
                "no-open-security-group",
                "no-overbroad-iam-policy",
                "no-path-traversal",
                "no-process-exit-in-request-path",
                "no-prompt-injection",
                "no-prototype-pollution",
                "no-public-cloud-storage",
                "no-query-in-loop",
                "no-race-without-timeout",
                "no-redos-prone-regex",
                "no-redundant-try-catch-rethrow",
                "no-secret-in-config-file",
                "no-send-after-next",
                "no-sensitive-data-in-logs",
                "no-sql-template-interpolation",
                "no-ssrf-unvalidated-url",
                "no-state-change-on-get",
                "no-swallowed-error-empty-catch",
                "no-sync-bcrypt-in-request-path",
                "no-sync-io-in-request-path",
                "no-sync-io-reachable-from-handler",
                "no-system-prompt-leak",
                "no-tainted-sink-via-helper",
                "no-throw-in-finally",
                "no-timing-unsafe-secret-compare",
                "no-trust-proxy-true",
                "no-unbounded-module-cache",
                "no-unbounded-promise-all",
                "no-unchecked-required-env",
                "no-uncleared-module-interval",
                "no-unreachable-code",
                "no-unsafe-deserialization",
                "no-unsafe-regexp-from-input",
                "no-vm-run-untrusted",
                "no-weak-cipher",
                "no-weak-hash-for-password",
                "no-xss-in-html-response",
                "prefer-node-protocol-imports",
                "require-error-handling-middleware",
                "require-fetch-timeout",
                "require-jwt-algorithms-allowlist",
                "require-pagination-limit",
                "require-secure-cookie-flags",
                "require-sigterm-handler",
                "restify-missing-error-handler",
                "secret-in-env-fallback"
              ]
            },
            "additionalProperties": {
              "enum": [
                "off",
                "warn",
                "error"
              ]
            }
          }
        }
      }
    }
  }
}
